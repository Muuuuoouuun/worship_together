# Local development. Use your public HTTPS origin for invitations / OAuth in production.
NEXTAUTH_URL=http://localhost:4000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Development only: 1 shows a name-only login on /login so several people can be tested
# from different browsers. Ignored when NODE_ENV=production.
DEV_LOGIN=

# Kakao Developers JavaScript app key (public key, not Admin/REST key)
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# Optional: absolute SQLite path on a persistent volume. Default: .data/teams.sqlite
TEAM_DATABASE_PATH=

# Optional: Web Push (notifications even when the app is closed). Generate once with:
#   npx web-push generate-vapid-keys
# Without these, notifications only arrive while the app is open.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push services. Defaults to NEXTAUTH_URL.
VAPID_SUBJECT=

# Existing library integration (independent of social login/team invitation storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
